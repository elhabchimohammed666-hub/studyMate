{
  "name": "studymate-mern",
  "version": "1.0.0",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "node --test",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}
